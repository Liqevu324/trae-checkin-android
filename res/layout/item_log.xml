<?xml version="1.0" encoding="utf-8"?>
<!-- 签到日志行：状态圆点 + 昵称 + 结果 + 时间 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="11dp"
    android:paddingBottom="11dp">

    <View
        android:id="@+id/dotStatus"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/dot_ok" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLogName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/placeholder_empty"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/tvLogResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/placeholder_empty"
            android:textColor="@color/ink_2"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLogTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/placeholder_empty"
        android:textColor="@color/ink_3"
        android:textSize="@dimen/text_badge" />

</LinearLayout>
