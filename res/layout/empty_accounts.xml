<?xml version="1.0" encoding="utf-8"?>
<!-- 账号列表空状态：图标 + 标题 + 说明 + 全宽主按钮 + 底部小字 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingLeft="28dp"
    android:paddingRight="28dp"
    android:paddingTop="40dp"
    android:paddingBottom="32dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_nav_checkin"
        android:alpha="0.9"
        android:scaleType="fitCenter"
        android:contentDescription="@string/empty_title" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/empty_title"
        android:textColor="@color/ink"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.6"
        android:text="@string/empty_hint"
        android:textColor="@color/ink_2"
        android:textSize="13sp" />

    <!-- 全宽主按钮：图标 + 文案 -->
    <LinearLayout
        android:id="@+id/btnAddAccountEmpty"
        android:layout_width="match_parent"
        android:layout_height="@dimen/btn_primary_height"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_btn_primary"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_add"
            android:scaleType="fitCenter"
            android:contentDescription="@string/add_account" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/add_account"
            android:textColor="@color/brand_on_primary"
            android:textSize="@dimen/text_body_l"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/empty_hint_auto"
        android:textColor="@color/ink_muted"
        android:textSize="@dimen/text_caption" />

</LinearLayout>
