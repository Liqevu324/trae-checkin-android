<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 全局主题：仅依赖系统 Material Light，无任何第三方 UI 库 -->
    <style name="Theme.Trae" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand_primary</item>
        <item name="android:colorPrimaryDark">@color/brand_primary</item>
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <!-- 全局 Activity 转场：轻微位移 + 淡入淡出，200ms 级，切换更顺滑 -->
        <item name="android:windowAnimationStyle">@style/PageAnimation</item>
    </style>

    <!-- 页面切换动画（Tab / 登录 / 文档页统一生效） -->
    <style name="PageAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/page_in</item>
        <item name="android:activityOpenExitAnimation">@anim/page_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/page_back_in</item>
        <item name="android:activityCloseExitAnimation">@anim/page_back_out</item>
    </style>

    <!-- ============ 设置页分组式组件（对齐原版视觉） ============ -->

    <style name="SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:textColor">@color/section_label</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:elevation">@dimen/card_elevation</item>
        <item name="android:paddingLeft">@dimen/card_padding</item>
        <item name="android:paddingRight">@dimen/card_padding</item>
    </style>

    <style name="SettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">@dimen/settings_row_padding_v</item>
        <item name="android:paddingBottom">@dimen/settings_row_padding_v</item>
    </style>

    <!-- 显式重复全部布局属性：不依赖 style 继承，避免个别 ROM 解析差异 -->
    <style name="SettingRowClickable">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">@dimen/settings_row_padding_v</item>
        <item name="android:paddingBottom">@dimen/settings_row_padding_v</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="SettingTextCol">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="SettingTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">@dimen/text_body_l</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingDesc">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:textSize">@dimen/text_badge</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="SettingSwitch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
    </style>

    <style name="SettingDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/line_2</item>
    </style>

    <style name="SettingAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:textColor">@color/brand_deep</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:textColor">@color/brand_deep</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingArrow">
        <item name="android:layout_width">@dimen/icon_sm</item>
        <item name="android:layout_height">@dimen/icon_sm</item>
        <item name="android:src">@drawable/ic_arrow_right</item>
    </style>

    <style name="AboutLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="AboutValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">@dimen/text_body_l</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
